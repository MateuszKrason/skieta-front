# Same-origin path, proxied to the Azure backend by the rule in
# public/_redirects. Keeping this relative (rather than pointing straight at
# api.skieta.com) means the browser only ever connects to the host it loaded
# the app from, so the app also works from skieta.netlify.app.
VITE_API_BASE_URL=/api

# Cookieless analytics (see src/lib/analytics.ts). Nothing is loaded and
# nothing is measured until BOTH of these are set, so the app ships fine
# without them.
#
# Umami Cloud (default provider):
#   VITE_ANALYTICS_SRC=https://cloud.umami.is/script.js
#   VITE_ANALYTICS_SITE=<website id z panelu Umami>
#
# Plausible instead: set VITE_ANALYTICS_PROVIDER=plausible,
#   VITE_ANALYTICS_SRC=https://plausible.io/js/script.js and
#   VITE_ANALYTICS_SITE=skieta.com
#
# Whichever host you pick must also be allowed in public/_headers, or the
# browser blocks the script with no visible error.

# Error reporting (see src/lib/errorReporting.ts). Nothing loads without a DSN.
#   VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#   VITE_SENTRY_ENVIRONMENT=production
# The ingest host must also be allowed in public/_headers under connect-src.
